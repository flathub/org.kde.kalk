{
    "id": "org.kde.kalk",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "kalk",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        "shared-modules/intltool/intltool-0.51.json",
        {
            "name": "libqalculate",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/Qalculate/libqalculate/releases/download/v5.13.2/libqalculate-5.13.2.tar.gz",
                    "sha256": "81af6c54018d5cbc9ce4df5a82c3ffb7b195193d72dcabb904f522b69936f3e6",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 230126,
                        "url-template": "https://github.com/Qalculate/libqalculate/releases/download/v$version/libqalculate-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "kalk",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/kalk-26.08.3.tar.xz",
                    "sha256": "794b706e665da989d5725929df8051870733aaacc58bc0bf174aa60a023f9e97",
                    "x-checker-data": {
                        "is-main-source": true,
                        "type": "anitya",
                        "project-id": 234907,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kalk-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
